{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      "$k": {
        ".write": true,
        ".validate": "$k.length <= 14 && newData.hasChildren(['name', 'rating'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 14" },
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
        "w": { ".validate": "newData.isNumber()" },
        "l": { ".validate": "newData.isNumber()" },
        "d": { ".validate": "newData.isNumber()" },
        "pf": { ".validate": "newData.isNumber()" },
        "pa": { ".validate": "newData.isNumber()" },
        "hist": { "$i": { ".validate": "newData.isNumber()" } },
        "vs": { "$o": { ".validate": "newData.hasChildren(['name'])" } },
        "games": { "$g": { ".validate": "newData.hasChildren(['t', 'opp', 'res'])" } },
        "seen": { "$g": { ".validate": "newData.isNumber()" } },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'key', 'st', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 14"
      }
    },
    "live": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "newData.hasChildren(['a', 'b', 'sa', 'sb', 'ts'])"
      }
    },
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        "host": { ".validate": "newData.isNumber()" },
        "up": { "$id": { ".validate": "newData.hasChildren(['k', 'm']) && newData.child('m').isString() && newData.child('m').val().length < 20000" } },
        "down": { "$k": { "$id": { ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length < 20000" } } },
        "$other": { ".validate": false }
      }
    },
    "cqlist": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "$code.length <= 10 && newData.hasChildren(['h', 'ts', 'o']) && newData.child('h').isString() && newData.child('h').val().length <= 14"
      }
    },
    "cq": {
      "$code": {
        ".read": true,
        ".write": true,
        "pl": { "$sid": { ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 14" } },
        "pos": { "$sid": { ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()" } },
        "st": { ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length < 60000" },
        "ev": { "$id": { ".validate": "newData.hasChildren(['s', 'm']) && newData.child('m').isString() && newData.child('m').val().length < 4000" } },
        "hl": { "$sid": { ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()" } },
        "hk": { "$to": { "$id": { ".validate": "newData.hasChildren(['f', 'n']) && newData.child('n').isString() && newData.child('n').val().length <= 14" } } },
        "hc": { ".validate": "newData.hasChildren(['n']) && newData.child('n').isNumber()" },
        "rtc": { "$to": { "$id": { ".validate": "newData.hasChildren(['f', 'k', 'd']) && newData.child('d').isString() && newData.child('d').val().length < 20000" } } },
        "$other": { ".validate": false }
      }
    },
    "invites": {
      "$key": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['from', 'code', 'ts']) && newData.child('code').isString() && newData.child('code').val().length <= 16"
        }
      }
    }
  }
}
